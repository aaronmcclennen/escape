<!-- File: `templates/admin_current_question.html.j2` (new admin page that auto-updates) -->
<!doctype html>
<html>
<head>
  <title>Admin — Current Question - {{ game.name }}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <style>
    .center { text-align:center; }
    .riddle-box { max-width:800px; margin:20px auto; padding:16px; border:1px solid #ddd; background:#fff; }
  </style>
</head>
<body>
  <div class="riddle-box">
    <h2>Game: {{ game.name }}</h2>
    <p>State: <strong id="game_state">{{ game.state }}</strong></p>

    <!-- show entry code for admin -->
    <p>Entry code: <strong id="entry_code">{{ entry_code or game.get_entry_code() or "" }}</strong></p>

    <h3 id="riddle_heading">Riddle #<span id="riddle_id">-</span></h3>
    <p id="riddle_text">Loading...</p>
    <img id="riddle_img" src="" alt="" style="max-width:100%; display:none; margin-top:8px;">
    <p id="riddle_hint" style="color:#666;"></p>
    <p>Attempts: <span id="riddle_attempts">0</span></p>

    <div class="center" style="margin-top:12px;">
      <a href="{{ url_for('admin.admin_index') }}" class="button">Back to Admin</a>
      <form action="{{ url_for('admin.admin_cancel_game') }}" method="post" style="display:inline; margin-left:8px;"
            onsubmit="return confirm('Are you sure you want to cancel this game? All progress will be lost.');">
        <button type="submit" class="button" style="background:#ff4d4d; color:#fff;">Cancel Game</button>
      </form>
    </div>
  </div>

<script type="text/javascript">
(function poll(){
  $.getJSON("{{ url_for('admin.admin_current_status') }}")
    .done(function(data){
      if (!data) { setTimeout(poll, 2000); return; }
      $("#game_state").text(data.state || "");
      // update entry code if present
      if (typeof data.entry_code !== "undefined") {
        $("#entry_code").text(data.entry_code || "");
      }
      if (data.game_over) {
        // redirect to the admin results page so admin sees final results
        window.location = "{{ url_for('admin.admin_results') }}";
        return;
      }
      $("#riddle_id").text(data.riddle_id || "-");
      $("#riddle_text").text(data.question || "");
      if (data.image_name) {
        $("#riddle_img").attr("src", "{{ url_for('static', filename='') }}" + data.image_name).show();
      } else {
        $("#riddle_img").hide();
      }
      $("#riddle_hint").text(data.hint || "");
      $("#riddle_attempts").text(data.attempts || 0);
    })
    .always(function(){ setTimeout(poll, 2000); });
})();
</script>
</body>
</html>
