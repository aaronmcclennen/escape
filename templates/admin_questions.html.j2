<!doctype html>
<html>
<head>
    <title>Admin — Questions</title>
</head>
<link rel="stylesheet" href="./static/style.css">
<h1>Admin — Questions</h1>

<div style="text-align:center">
  <a href="{{ url_for('admin.admin_index') }}" class="button">Admin Menu</a>
  <a href="/admin/questions/new" class="button">Create new question</a>
  <a href="/admin/progress" class="button">Progress</a>
  <a href="/admin/questions/download" class="button" download="riddles.json">Download JSON</a>
</div>

      <!-- Post back to the same page; name will be saved into the game object in-memory -->
      <form method="post" action="{{ url_for('admin.admin_questions') }}" style="margin-top:12px;">
        <label for="game-name">Active game name</label>
        <input id="game-name" name="name" type="text" value="{{ game.name }}" style="width:100%;padding:8px;margin-top:6px;">
        <div style="margin-top:8px;">
          <button type="submit" class="button">Save Game Name</button>
        </div>
      </form>
<ul>
    {% for r in game.riddles %}
      {% set idx = loop.index0 %}
      <li>
        <strong>({{ idx }}) {{ r.get_riddle() }}</strong><br>
        <em>Answer(s):</em> {{ r.answer|join(", ") }}<br>
        <em>Hint:</em> {{ r.get_hint() }}<br>
        <em>Image:</em> {{ r.get_image_name() }}<br>

        {# Move controls: hide Up for first, Down for last #}
        {% if idx > 0 %}
          <form action="/admin/questions/move/{{ idx }}/up" method="post" style="display:inline">
            <button type="submit">Move Up</button>
          </form>
        {% endif %}
        {% if idx < total_count - 1 %}
          <form action="/admin/questions/move/{{ idx }}/down" method="post" style="display:inline">
            <button type="submit">Move Down</button>
          </form>
        {% endif %}

        <form action="/admin/questions/edit/{{ idx }}" method="get" style="display:inline">
          <button type="submit">Edit</button>
        </form>
        <form action="/admin/questions/delete/{{ idx }}" method="post" style="display:inline" onsubmit="return confirm('Delete question?')">
          <button type="submit">Delete</button>
        </form>
      </li>
    {% endfor %}
</ul>

</html>