<!doctype html>
<html>
<head>
  <title>Admin Menu</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <style>
    /* small page-specific layout fixes to avoid obscured labels */
    .container { max-width: 900px; margin: 18px auto; padding: 12px; }
    .box { padding: 16px; border: 1px solid #ddd; border-radius: 6px; background: #fff; }
    .box h3 { margin: 0 0 8px 0; font-size: 1.15em; }
    label { display: block; margin-bottom: 6px; font-weight: 600; }
    select { width: 100%; padding: 8px; font-size: 1em; box-sizing: border-box; }
    .actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .actions .button { padding: 8px 12px; }
    .row { display: flex; gap: 12px; align-items: flex-start; margin-top: 16px; flex-wrap: wrap; }
    .upload, .create { flex: 1 1 320px; }
    .flash { max-width:720px; margin:12px auto 16px; padding:8px; }
    .resume-banner { padding: 12px; margin-top: 12px; background: #e6f7ff; border: 1px solid #b3e0ff; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .resume-label { font-weight: 600; font-size: 0.95em; }
    .resume-button { width: auto; white-space: nowrap; padding: 10px 18px; margin: 0; flex-shrink: 0; }
  </style>
</head>
<body>
  <div class="container">

    <h1>Admin Menu</h1>

    {# flashed messages #}
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        <div class="flash">
          {% for category, msg in messages %}
            <div style="padding:10px;margin-bottom:8px;border-radius:4px;
                        {% if category == 'error' %}background:#ffd6d6;border:1px solid #ff9b9b;{% else %}background:#e6ffea;border:1px solid #9be59b;{% endif %}">
              {{ msg }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endwith %}

    <div class="box">
      <h3>Available Games</h3>
      {% if games %}
        <form id="game-select-form" method="get" action="{{ url_for('admin.admin_questions') }}">
          <label for="game-select">Select a game</label>
          <select id="game-select" name="game_id" aria-label="Select game">
            {% for g in games %}
              <option value="{{ g.name }}" {% if loop.first %}selected{% endif %}>{{ g.name }} — {{ g.state }}</option>
            {% endfor %}
          </select>

          <div class="actions">
            <button type="submit" class="button">Manage Questions</button>
            <button type="submit" class="button" formaction="{{ url_for('admin.admin_download_questions') }}" formmethod="get">Download JSON</button>

            {# Stage Game lives inside the outer form so it can read game_id from the dropdown #}
            {% if not (user_active and user_active.state in (user_active.STATE_STAGED, user_active.STATE_IN_PROGRESS)) %}
              <button type="submit" class="button" formaction="{{ url_for('admin.admin_start_game') }}" formmethod="post" style="margin-left:8px;">Stage Game</button>
            {% endif %}

            {# Delete Game #}
            <button type="submit" class="button" formaction="{{ url_for('admin.admin_delete_game') }}" formmethod="post"
                    style="background-color:#c0392b;margin-left:8px;"
                    onclick="return confirm('Delete the selected game? This cannot be undone.')">Delete Game</button>
          </div>
        </form>

        {# Resume Game must be its own top-level form (NOT nested inside game-select-form) #}
        {% if user_active and user_active.state in (user_active.STATE_STAGED, user_active.STATE_IN_PROGRESS) %}
          <div class="resume-banner">
            <span class="resume-label">▶ <strong>{{ user_active.name }}</strong> is {{ user_active.state | replace('_', ' ') }}</span>
            <form action="{{ url_for('admin.admin_resume_game') }}" method="post" style="display:inline;">
              <button type="submit" class="button resume-button">Resume Game</button>
            </form>
          </div>
        {% endif %}


      {% else %}
        <p>No games found in the configured games directory.</p>
      {% endif %}
    </div>

    <div class="row">
      <div class="upload box">
        <h3>Upload new game (JSON)</h3>
        <p>Choose a riddles JSON file to add to the game list. The file will overwrite the configured config file.</p>
        <form id="upload-form" action="{{ url_for('admin.admin_upload') }}" method="post" enctype="multipart/form-data">
          <input id="game-file-input" type="file" name="file" accept=".json,application/json" style="display:none;">
          <label for="game-file-input" class="button" style="cursor:pointer;">Choose and Upload</label>
          <span id="selected-filename" style="margin-left:8px;">No file chosen</span>
        </form>
      </div>

      <div class="create box">
        <h3>Create New Game</h3>
        <form id="create-game-form" action="{{ url_for('admin.admin_questions') }}" method="post">
          <input type="hidden" name="create_new" value="1">
          <label for="new-game-name">Game name <span style="color:#c00">*</span></label>
          <input id="new-game-name" type="text" name="new_game_name" required placeholder="Enter a unique game name" style="width:100%;padding:8px;margin-bottom:8px;">
          <div>
            <button type="submit" class="button">Create New Game</button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    (function(){
      const input = document.getElementById('game-file-input');
      const form = document.getElementById('upload-form');
      const filenameSpan = document.getElementById('selected-filename');
      if (!input || !form) return;
      input.addEventListener('change', function(){
        const name = input.files && input.files.length ? input.files[0].name : 'No file chosen';
        filenameSpan.textContent = name;
        if (input.files && input.files.length) form.submit();
      });
    })();
  </script>
</body>
</html>