<!doctype html>
<html>
<head>
  <title>Waiting for Game</title>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <link rel="stylesheet" href="./static/style.css">
</head>
<body>
  {% if user_name %}
    <p class="player-name">Player: <strong>{{ user_name }}</strong></p>
  {% endif %}

  <h1>Waiting for "{{ game.name }}" to start</h1>
  <p>Please wait — the game host will start the game shortly.</p>
  <p class="small">This page will automatically move you to the riddle when the game begins.</p>

<script type="text/javascript">
(function poll(){
  $.getJSON("{{ url_for('wait_status') }}")
    .done(function(data){
      if (data && data.state === "in_progress") {
        window.location = "{{ url_for('riddle') }}";
      } else {
        // continue polling
        setTimeout(poll, 2000);
      }
    })
    .fail(function(){
      // retry on failure
      setTimeout(poll, 3000);
    });
})();
</script>
</body>
</html>
