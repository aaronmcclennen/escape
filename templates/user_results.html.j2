<!doctype html>
<html>
<head>
  <title>Results — {{ game.name }}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
  <div class="center">
    <h2>Game Complete: {{ game.name }}</h2>
    {% if duration_text %}
      <p>Total time: <strong>{{ duration_text }}</strong></p>
    {% else %}
      <p>Total time: <strong>Unknown</strong></p>
    {% endif %}

    <h3>Scores</h3>
    <ul>
      {% for s in scores %}
        <li>{{ s.display_name }} — {{ s.correct }} correct</li>
      {% endfor %}
    </ul>

    <p>
      <a href="{{ url_for('index') }}" class="button">Back to Games</a>
    </p>
  </div>
</body>
</html>
