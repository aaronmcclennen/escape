<!-- File: `templates/admin_active_game.html.j2` -->
<!doctype html>
<html>
<head>
  <title>Active Game - {{ game.name }}</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <style>
    .share-box { margin-top:16px; padding:12px; border:1px solid #b3e0ff; background:#e6f7ff; border-radius:6px; }
    .share-box label { font-weight:600; display:block; margin-bottom:6px; }
    .share-url-row { display:flex; gap:8px; align-items:center; }
    .share-url-row input { flex:1; padding:8px; font-size:0.95em; border:1px solid #ccc; border-radius:4px; background:#fff; }
    .copy-btn { padding:8px 14px; border:none; border-radius:4px; background:cadetblue; color:#fff; cursor:pointer; white-space:nowrap; }
    .copy-btn:hover { background:#4a9a9a; }
    .players-box { margin-top:16px; padding:12px; border:1px solid #c3e6cb; background:#f0fff4; border-radius:6px; }
    .players-box h3 { margin:0 0 8px 0; font-size:1em; color:#2d6a4f; }
    #player-list { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:6px; }
    #player-list li { background:#d4edda; border:1px solid #b2d8bb; border-radius:12px; padding:3px 10px; font-size:0.9em; color:#155724; }
    #player-count { font-weight:600; }
  </style>
</head>
<body>
  <div style="max-width:720px;margin:24px auto;padding:16px;border:1px solid #ddd;">
    <h2>Active Game: {{ game.name }}</h2>
    <p>Entry code:</p>
    <pre style="font-size:1.25em;padding:8px;border:1px solid #ccc;background:#fafafa;">{{ entry_code }}</pre>

    <div class="share-box">
      <label>Share this link with players:</label>
      <div class="share-url-row">
        <input id="join-url" type="text" value="{{ join_url }}" readonly onclick="this.select()">
        <button class="copy-btn" onclick="copyJoinUrl()">Copy Link</button>
      </div>
      <small id="copy-msg" style="color:green;display:none;margin-top:4px;">✓ Copied!</small>
    </div>

    <div class="players-box">
      <h3>Players joined: <span id="player-count">0</span></h3>
      <ul id="player-list"><li style="color:#888;font-style:italic;">Waiting for players…</li></ul>
    </div>

    <p style="margin-top:16px;">
      <form action="{{ url_for('admin.admin_cancel_game') }}" method="post" style="display:inline"
            onsubmit="return confirm('Cancel this game? All progress will be lost. Players will have to reload the waiting room page.');">
        <button type="submit" class="button" style="background:#ff4d4d;color:#fff;">Cancel Game</button>
      </form>

      <!-- Start button: posts to admin.begin to transition staged -> in_progress -->
      <form action="{{ url_for('admin.admin_begin_game') }}" method="post" style="display:inline">
        <button type="submit" class="button" style="margin-left:8px;">Start Game</button>
      </form>
    </p>
  </div>

  <script>
    function copyJoinUrl() {
      var input = document.getElementById('join-url');
      navigator.clipboard.writeText(input.value).then(function() {
        var msg = document.getElementById('copy-msg');
        msg.style.display = 'inline';
        setTimeout(function(){ msg.style.display = 'none'; }, 2000);
      });
    }

    (function pollLobby() {
      $.getJSON("{{ url_for('admin.admin_lobby_status') }}")
        .done(function(data) {
          if (!data || data.error) { setTimeout(pollLobby, 3000); return; }
          $('#player-count').text(data.count || 0);
          var list = $('#player-list');
          list.empty();
          if (data.players && data.players.length > 0) {
            $.each(data.players, function(i, name) {
              list.append($('<li>').text(name));
            });
          } else {
            list.append('<li style="color:#888;font-style:italic;">Waiting for players…</li>');
          }
        })
        .always(function() { setTimeout(pollLobby, 3000); });
    })();
  </script>
</body>
</html>
