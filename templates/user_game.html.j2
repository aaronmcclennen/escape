<!doctype html>
<html>
<head>
    <title>{{ title }}</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
</head>
<link rel="stylesheet" href="./static/style.css">
<script type=text/javascript>
var currentRiddleId = "{{ riddle_id }}";
var startElapsed = {{ elapsed_seconds }};
var elapsedStart = Date.now();

function updateElapsedTime() {
  var elapsed = startElapsed + Math.floor((Date.now() - elapsedStart) / 1000);
  var mins = Math.floor(elapsed / 60);
  var secs = elapsed % 60;
  var display = mins + ":" + (secs < 10 ? "0" : "") + secs;
  $("#elapsed-time").text("Elapsed: " + display);
}

setInterval(updateElapsedTime, 1000);

function refresh_riddle() {
    $.getJSON("/data",
            function (data) {
                if (data.hasOwnProperty("game_over")) {
                    location.reload();
                }
                else if (data["riddle_id"] != currentRiddleId) {
                    // Another user advanced the question — reload to clear cooldowns and show new riddle
                    location.reload();
                }
                else {
                    $("#riddle_id").text(data["riddle_id"]);
                    $("#riddle").text(data["riddle"]);
                    $("#hint").text(data["hint"]);
                    $("#riddle_img").attr("src", data["image_name"]);
                    // Update elapsed time from server
                    if (typeof data["elapsed_seconds"] !== "undefined") {
                      startElapsed = data["elapsed_seconds"];
                      elapsedStart = Date.now();
                    }
                }
            }
    );
}
setInterval('refresh_riddle()', 3000);
</script>

{% if user_name %}
  <p class="player-name">Player: <strong>{{ user_name }}</strong></p>
{% endif %}

<div style="text-align:center;color:#666;font-size:0.95em;margin-bottom:8px;">
  <span id="elapsed-time">Elapsed: {{ "%d:%02d" | format(elapsed_seconds // 60, elapsed_seconds % 60) }}</span>
</div>

<h1 id="riddle_id">
    Riddle #{{ riddle_id }}
</h1>
<br>
<h2 id="riddle">
    {{ riddle }}
</h2>
<img id="riddle_img" src="./static/{{ image_name }}">
{% if not advance %}
    <form id="guess-form" action="{{ url_for('riddle') }}" method="post">
      <label for="guess">Guess:</label>
      <input type="text" id="guess" name="guess" autocomplete="off">
      <input type="submit" id="submit-btn" value="Submit">
    </form>
    {% if cooldown_seconds and cooldown_seconds > 0 %}
    <p id="cooldown-msg" style="color:darkred;text-align:center;font-weight:600;">
      ⏳ Please wait <span id="cooldown-timer">{{ cooldown_seconds }}</span> seconds…
    </p>
    <script>
    (function() {
      var remaining = {{ cooldown_seconds }};
      var btn = document.getElementById('submit-btn');
      var input = document.getElementById('guess');
      var msg = document.getElementById('cooldown-msg');
      var timer = document.getElementById('cooldown-timer');
      btn.disabled = true;
      input.disabled = true;
      var iv = setInterval(function() {
        remaining--;
        if (remaining <= 0) {
          clearInterval(iv);
          btn.disabled = false;
          input.disabled = false;
          msg.style.display = 'none';
          input.focus();
        } else {
          timer.textContent = remaining;
        }
      }, 1000);
    })();
    </script>
    {% endif %}
<h2 id="hint">
    Hint: {{ hint }}
</h2>
{% endif %}
{% if response %}
<br>
<h4>
    {{ response }}
</h4>
{% endif %}
<br>
<br>
{% if advance %}
<div class="center">
    <a href="{{ url_for('riddle') }}" class="button">Next Riddle</a>
</div>
{% endif %}
</html>